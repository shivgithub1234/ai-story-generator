# demo runs fixed sample data through the graph without any model calls.
# Set STORY_PROVIDER=gemini for real AI generation.
STORY_PROVIDER=demo
GEMINI_API_KEY=
# Set a Gemini model ID available in your Google AI Studio account.
GEMINI_MODEL=
# Required only for saved-story endpoints; initialize with python -m story_api.database.
DATABASE_URL=
# Exact values from your identity provider. No insecure development auth bypass exists.
AUTH_ISSUER=
AUTH_AUDIENCE=story-api
AUTH_JWKS_URL=
# Clerk: allowed frontend origins. Auth0: allowed client IDs matching its azp claim.
AUTH_AUTHORIZED_PARTIES=http://localhost:3000

# Per-account admissions; one run includes its automatic retries and rewrite.
STORY_REQUESTS_PER_24H=10
STORY_MAX_ACTIVE_JOBS=2
# Local experiments only. Keep false on any shared/public service.
STORY_ENABLE_UNMETERED_DEV_ENDPOINT=false
