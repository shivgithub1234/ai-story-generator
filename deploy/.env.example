# Copy to deploy/.env (ignored). This file is passed using --env-file deploy/.env.
RELEASE_TAG=local
STORY_ENV=production
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
STORY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
AUTH_ISSUER=https://your-production-clerk-domain
AUTH_AUDIENCE=story-api
AUTH_JWKS_URL=https://your-production-clerk-domain/.well-known/jwks.json
AUTH_AUTHORIZED_PARTIES=https://stories.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
STORY_REQUESTS_PER_24H=10
STORY_MAX_ACTIVE_JOBS=2
